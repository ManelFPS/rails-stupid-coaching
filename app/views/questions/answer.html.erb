<div class="container mt-4">
  <h1 class="mb-4">Stupid Coaching</h1>
  <div class="border-start border-5 ps-3 py-2 mb-4">
    <p><%=@question%></p>
    <p>-<i>You</i></p>
  </div>
  <div class="border-start border-5 ps-3 py-2 mb-4 bg-warning bg-opacity-10">
    <p><b><%=@answer%></b></p>
    <p>-<i>Your coach</i></p>
  </div>
  <%= link_to "Ask a new question", ask_path, class: "text-decoration-none" %>
</div>
